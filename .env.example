# ==============================================================================
# OrgFlow Studio — Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Security & Sessions
SESSION_SECRET=change_me_to_a_secure_random_string_at_least_32_chars
CORS_ORIGIN=http://localhost:3000

# Local OrgFlow Database (SQLite for Dev / MVP)
DATABASE_URL="file:./dev.db"

# Kintone Integration (Backend Only - Never exposed to browser)
# Write mode is DISABLED by default for safety
KINTONE_WRITE_ENABLED=false
KINTONE_BASE_URL=https://your-domain.cybozu.com
KINTONE_READ_API_TOKEN=your_read_token_here
KINTONE_WRITE_API_TOKEN=your_write_token_here

# Kintone App IDs
KINTONE_APP_EMPLOYEE=53
KINTONE_APP_ORGANIZATION=791
KINTONE_APP_ASSIGNMENTS=792
KINTONE_APP_CHANGE_REQUESTS=793
