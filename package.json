{
  "name": "orgflow-studio-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "spike:test": "vitest run"
  },
  "devDependencies": {
    "@kintone/rest-api-client": "^6.2.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "@types/pdf-parse": "^1.1.5",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "sharp": "^0.35.3"
  }
}
