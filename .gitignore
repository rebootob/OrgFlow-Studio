# ==============================================================================
# OrgFlow Studio — Security-First .gitignore Baseline
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
.turbo/

# Environment and Secret Files (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.token
secrets/

# Database and SQLite Files
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.db
*.db-journal
*.db-wal
prisma/dev.db
prisma/dev.db-journal

# HR Sensitive Data, Snapshots, and Exports
*.csv
*.xlsx
*.xls
app53_records*
app791_records*
app792_records*
app793_records*
employee_master_export*
kintone_snapshot*

# Signed Approval Documents & Uploads
uploads/
*.pdf
!docs/**/*.pdf
signed_documents/
approval_evidence/

# Backups & Pre-Sync Snapshots
backups/*
!backups/README.md

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pino.log

# IDE & OS Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
